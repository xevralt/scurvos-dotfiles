* {
    matugen-background: {{colors.surface.default.hex}};
    matugen-foreground: {{colors.on_surface.default.hex}};
    matugen-accent: {{colors.primary.default.hex}};
    matugen-accent-alt: {{colors.secondary.default.hex}};
    matugen-muted: {{colors.outline.default.hex}};
    matugen-selected: {{colors.surface_container_high.default.hex}};
    matugen-border: {{colors.outline_variant.default.hex}};
}
