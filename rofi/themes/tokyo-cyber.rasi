
@import "~/.cache/matugen/rofi-colors.rasi"

configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 11";
}

* {
    background:     @matugen-background;
    background-alt: @matugen-selected;
    foreground:     @matugen-foreground;
    muted:          @matugen-muted;
    blue:           @matugen-accent;
    cyan:           @matugen-accent;
    purple:         @matugen-accent-alt;
    selected:       @matugen-selected;

    bg:             @background;
    fg:             @foreground;
    accent:         @cyan;
    border-color:   @matugen-border;
}

window {
    width: 520px;
    border: 1px;
    border-color: @border-color;
    border-radius: 14px;
    background-color: @background;
}

mainbox {
    padding: 12px;
    spacing: 9px;
    background-color: @background;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 10px 12px;
    spacing: 10px;
    border: 1px;
    border-color: @border-color;
    border-radius: 9px;
    background-color: @background-alt;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent;
    background-color: transparent;
}

entry {
    placeholder: "Search applications...";
    placeholder-color: @muted;
    text-color: @foreground;
    background-color: transparent;
}

listview {
    lines: 6;
    spacing: 3px;
    fixed-height: true;
    scrollbar: false;
    background-color: transparent;
}

element {
    padding: 9px 10px;
    spacing: 10px;
    border: 1px;
    border-color: transparent;
    border-radius: 8px;
    background-color: transparent;
    text-color: @foreground;
    children: [ element-icon, element-text ];
}

element-icon {
    size: 22px;
    background-color: transparent;
}

element-text {
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;
}

element selected {
    background-color: @selected;
    text-color: @accent;
    border: 1px;
    border-color: @border-color;
}

element selected.normal {
    background-color: @selected;
    text-color: @accent;
}

element-text selected {
    text-color: @accent;
}

